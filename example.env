# Local credentials for the Oracle reference stack and the Rust workbench.
# Copy this file to `.env` (git-ignored) and fill in the values. Never commit `.env`.
# Local development only: use throwaway-container passwords.

# Database admin password (set as ORACLE_PWD when the database container starts)
ORACLE_PWD=

# Test schema user for the Forms samples and the Rust workbench
DB_USER=
DB_PASSWORD=
DB_SERVICE=

# Read by the Rust server and CLI
OFW_DB_USER=
OFW_DB_PASSWORD=

# WebLogic admin (AdminServer console and boot.properties)
WLS_ADMIN_USER=
WLS_ADMIN_PASSWORD=

# Optional: host folder holding the Forms 14c Oracle Home. Leave empty for the default (oracle-reference-stack/oracle_home_14c).
# Recommended on both platforms: set it BEFORE installing to an absolute path (no ~) outside the repo checkout:
#   macOS:       OFW_ORACLE_HOME=/Users/<you>/oracle_home_14c
#   Windows WSL: OFW_ORACLE_HOME=/home/<you>/oracle_home_14c  (Ubuntu's own disk; never /mnt/c or the repo folder)
# See the setup skill's references/oracle-home-location.md.
OFW_ORACLE_HOME=

# Optional: extra host/WSL folder(s) (colon-separated) holding read-only external forms and dependencies
# (.fmb, .fmx, .pll, .plx, .olb, .mmb, .mmx). External sources are never modified or copied into this repository.
# All conversion, compilation, and diagnostic outputs must use OFW_WORK_DIR or another designated directory outside
# both this repository and the external source tree.
OFW_FORMS_PATH_EXTRA=

# Optional: folder for everything the tools stage, convert and compile.
# For external sources, keep this directory outside the repository and external source tree. It must remain inside
# the Oracle Home so the Forms container can access it; set OFW_ORACLE_HOME outside the repository when needed.
# Leave empty for <OFW_ORACLE_HOME>/ofw-work, which the Forms container already mounts. Compiled .fmx/.mmx/.plx files
# are published to <OFW_FORMS_APPS_DIR>/<OFW_APP_NAME>/ (default <OFW_ORACLE_HOME>/forms_apps/default), keeping
# <OFW_ORACLE_HOME>/forms strictly for Oracle product binaries.
OFW_WORK_DIR=

# Optional Podman container name. Leave empty for the default (forms-server-14c).
OFW_FORMS_CONTAINER=

# Optional Rust workbench HTTP port (defaults to 7070).
# PORT=7070

# Dedicated application deployment settings (published under <OFW_FORMS_APPS_DIR>/<OFW_APP_NAME>/, ahead of
# /oracle_home_14c/forms in FORMS_PATH).
OFW_APP_NAME=default
# OFW_FORMS_APPS_DIR=/home/<you>/oracle_home_14c/forms_apps
# OFW_FORMS_CONFIG=standaloneapp

# Optional, for the command-line scripts only (convert_pll.py --userid-from-env): a database logon as user/password@alias.
# The Preview dialog does not read it. Prefer exporting it in your shell instead of storing a password in this file.
# OFW_PREVIEW_DB_LOGON=

# Native runtime: what the HOST built-in may do (deny | emulate | allow:prog1,prog2). Default: deny.
# OFW_HOST_POLICY=deny
