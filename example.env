# Local credentials for the Oracle reference stack and the Rust workbench.
# Copy this file to `.env` (git-ignored) and fill in the values. Never commit `.env`.
# Local development only: use throwaway-container passwords.

# Database admin password (set as ORACLE_PWD when the database container starts)
ORACLE_PWD=

# Test schema user for the Forms samples and the Rust workbench
DB_USER=
DB_PASSWORD=
DB_SERVICE=

# Read by the Rust server and CLI
OFW_DB_USER=
OFW_DB_PASSWORD=

# WebLogic admin (AdminServer console and boot.properties)
WLS_ADMIN_USER=
WLS_ADMIN_PASSWORD=

# Optional: host folder holding the Forms 14c Oracle Home. Leave empty for the default (oracle-reference-stack/oracle_home_14c).
# Windows: set it BEFORE installing, to a folder on Ubuntu's own disk, for example /home/<you>/oracle_home_14c. Never install into the repo folder (slow /mnt/c mount).
# Use an absolute path (no ~). See the setup skill's references/oracle-home-location.md.
OFW_ORACLE_HOME=

# Optional: extra host/WSL folder(s) (colon-separated) holding your own forms and their dependencies
# (.fmb, .fmx, .pll, .plx, .olb, .mmb, .mmx), for example /mnt/c/forms on Windows WSL. The workbench loads external
# forms from here and saves them back here (never into samples/); the compile and convert scripts copy the .pll,
# .olb and .mmb files from here into OFW_WORK_DIR so a module's attached libraries are found. Sources are only read.
OFW_FORMS_PATH_EXTRA=

# Optional: folder for everything the tools stage, convert and compile (never inside the repository).
# Leave empty for <OFW_ORACLE_HOME>/ofw-work, which the Forms container already mounts. For compiles it must stay
# inside the Oracle Home: forms-server-14c mounts only the repository and the Oracle Home. Compiled .fmx/.mmx/.plx files
# are published from here to <OFW_ORACLE_HOME>/forms. Created on first use (through `podman unshare` when the
# Oracle Home belongs to the container user); to create it by hand run compile_form.py --init-work-dir.
OFW_WORK_DIR=

# Optional, for the command-line scripts only (convert_pll.py --userid-from-env): a database logon as user/password@alias.
# The Preview dialog does not read it. Prefer exporting it in your shell instead of storing a password in this file.
# OFW_PREVIEW_DB_LOGON=
